# Copie para .env.local e preencha. Sem as chaves Supabase o site funciona com o conteúdo por omissão
# (sem login nem dashboard).

# URL público do site: base de TODOS os links absolutos (emails, sitemap, canonical, confirmação de conta).
# Use sempre o domínio de produção, mesmo em desenvolvimento, para os emails de teste apontarem ao site real.
NEXT_PUBLIC_SITE_URL=https://billtech.online

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA: só no servidor. Usada para guardar mensagens do formulário público.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com) — envio das mensagens do formulário por email
RESEND_API_KEY=
# Sem domínio verificado, mantenha o remetente de teste (só entrega ao email da conta Resend)
RESEND_FROM=BillTech <onboarding@resend.dev>
# Destinatário por omissão; pode ser alterado na dashboard → Definições
CONTACT_TO_EMAIL=946393361bill@gmail.com
